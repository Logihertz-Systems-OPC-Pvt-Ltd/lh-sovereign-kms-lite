{
  "policy_id": "LH-POL-KMS-VULNERABLE-001",
  "policy_name": "Insecure Legacy KMS Policy with Critical Sovereign Deficiencies",
  "organization": "Untrusted Insecure Enclave",
  "shamir_unseal_required": false,
  "shamir_threshold_m": 1,
  "shamir_total_shares_n": 1,
  "allow_plaintext_root_key_file": true,
  "aead_cipher": "AES-CBC",
  "dek_key_bits": 128,
  "require_mtls_client_auth": false,
  "allow_unauthenticated_kms_rpc": true,
  "require_encryption_context_aad": false,
  "auto_key_rotation_enabled": false,
  "key_rotation_interval_days": 365,
  "mlock_key_memory": false,
  "zeroize_dek_after_op": false,
  "disable_os_swap": false,
  "verify_csprng_health_on_boot": false,
  "max_invocations_per_kek_version": 500000000,
  "allow_raw_kek_export": true,
  "enforce_least_privilege_key_grants": false,
  "min_key_deletion_window_days": 1,
  "auto_seal_on_intrusion_alert": false,
  "hash_chained_kms_audit_log": false
}
