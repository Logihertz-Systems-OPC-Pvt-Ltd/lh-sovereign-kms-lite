{
  "policy_id": "LH-POL-KMS-HARDENED-001",
  "policy_name": "Logihertz Sovereign KMS Tier-4 Enclave Hardened Policy",
  "organization": "Logihertz Systems (OPC) Private Limited",
  "shamir_unseal_required": true,
  "shamir_threshold_m": 3,
  "shamir_total_shares_n": 5,
  "allow_plaintext_root_key_file": false,
  "aead_cipher": "AES-256-GCM",
  "dek_key_bits": 256,
  "require_mtls_client_auth": true,
  "allow_unauthenticated_kms_rpc": false,
  "require_encryption_context_aad": true,
  "auto_key_rotation_enabled": true,
  "key_rotation_interval_days": 60,
  "mlock_key_memory": true,
  "zeroize_dek_after_op": true,
  "disable_os_swap": true,
  "verify_csprng_health_on_boot": true,
  "max_invocations_per_kek_version": 10000000,
  "allow_raw_kek_export": false,
  "enforce_least_privilege_key_grants": true,
  "min_key_deletion_window_days": 14,
  "auto_seal_on_intrusion_alert": true,
  "hash_chained_kms_audit_log": true
}
